<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>Corter-ModSync-Prepatch</AssemblyName>
    <Version>0.12.6</Version>
    <AssemblyVersion>0.12.6.0</AssemblyVersion>
    <FileVersion>0.12.6.0</FileVersion>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared MAX_PATH helper — link just this one file (the patcher doesn't need the rest of Utility). -->
    <Compile Include="..\ModSync.Utility\LongPath.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <!--
      Mono.Cecil ships in BepInEx/core/ — available at preloader stage.
      Private="false": compile-time reference only, not copied to output.
    -->
    <PackageReference Include="Mono.Cecil" Version="0.11.*" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <!--
    Newtonsoft.Json ships with EFT and with BepInEx — available at preloader stage.
    Private="false": compile-time reference only, not copied to output.
  -->
  <ItemGroup>
    <Reference Include="Newtonsoft.Json" HintPath="..\References\Newtonsoft.Json.dll" Private="false" />
  </ItemGroup>

</Project>
