<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>Corter-ModSync.Patcher</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <PackageReference Include="BepInEx.Preloader.Core" Version="5.*" />
  </ItemGroup>

  <!--
    Newtonsoft.Json ships with EFT and with BepInEx — available at preloader stage.
    Private="false": compile-time reference only, not copied to output.
  -->
  <ItemGroup>
    <Reference Include="Newtonsoft.Json" HintPath="..\References\Newtonsoft.Json.dll" Private="false" />
  </ItemGroup>

</Project>
