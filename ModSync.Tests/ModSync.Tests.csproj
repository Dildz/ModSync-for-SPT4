<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <MSBuildWarningsAsMessages>NU1702</MSBuildWarningsAsMessages>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="6.0.0"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0"/>
        <PackageReference Include="NUnit" Version="3.14.0"/>
        <PackageReference Include="NUnit.Analyzers" Version="3.9.0"/>
        <PackageReference Include="NUnit3TestAdapter" Version="4.5.0"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="NUnit.Framework"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\ModSync\ModSync.csproj" />
    </ItemGroup>

    <!--
      Copy the EFT/Unity reference DLLs into the test output directory.

      The ModSync client project marks these refs as `Private="false"` (compile-time
      only - the real DLLs ship with EFT at runtime, so the mod release doesn't
      duplicate them). That's correct for the production build, but it means when
      ModSync.Tests runs and tries to load test fixtures that touch e.g. `Plugin.cs`,
      .NET goes looking for `UnityEngine.dll` next to the test binary and can't find
      it - every test that traverses Unity types fails with "Could not load file or
      assembly 'UnityEngine'".

      Fix: explicitly stage the DLLs into the test bin via the `None` item type with
      `CopyToOutputDirectory`. `None` means "not compiled, just a file alongside the
      project"; the `Link` attribute strips the `..\References\` prefix so the file
      lands directly in bin/, not bin/References/.

      Newtonsoft.Json is deliberately excluded - the test SDK / NUnit pipeline pulls
      its own copy via NuGet, and shipping two side-by-side risks a binding conflict.
    -->
    <ItemGroup>
      <None Include="..\References\*.dll" Exclude="..\References\Newtonsoft.Json.dll">
        <Link>%(Filename)%(Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

</Project>
