# Default: treat all text as LF (server runs cross-platform; consistent line endings
# avoid spurious diffs between Windows dev machines and the Linux VPS).
* text eol=lf

# Binary files - don't try to normalize line endings on these.
# Without this, git warns on every commit that touches References/ or any .sln.
*.dll binary
*.exe binary
*.pdb binary
*.snk binary
References/** binary
