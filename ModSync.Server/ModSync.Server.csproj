<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    SPT 4 server mods are .NET 9 class libraries that get loaded by the SPT server at startup.
    Pattern follows server-mod-examples + lessons from NarcoNet (PrivateAssets/ExcludeAssets on
    SPT packages so they don't get copied to the mod output dir - SPT provides them at runtime).

    SDK is `Microsoft.NET.Sdk.Web` (not the bare `Microsoft.NET.Sdk`) because IHttpListener
    impls use ASP.NET Core types (HttpContext, HttpRequest, HttpResponse). The Web SDK adds
    an implicit FrameworkReference to Microsoft.AspNetCore.App which brings those in. All
    official server-mod-examples use this SDK for the same reason.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ModSync.Server</RootNamespace>

    <!--
      Output layout follows the official server-mod-examples convention:
      bin/<Config>/<ProjectName>/<AssemblyName>/   - drops a clean mod folder you can copy into
      a real SPT install at user/mods/Corter-ModSync/ for testing.
    -->
    <OutputPath>bin\$(Configuration)\$(ProjectName)\$(AssemblyName)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!--
      Class libraries do NOT copy NuGet package assemblies to the output folder by default -
      a normal app resolves them through deps.json at runtime, but a mod DLL is side-loaded by
      SPT and gets no such resolution. Without this, Markdig.dll is simply absent from the mod
      folder and the docs page throws FileNotFoundException the first time it renders.
      The SPT packages are unaffected: ExcludeAssets="runtime" keeps them out regardless.
    -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <!-- Don't ship debug symbols or per-build deps.json in mod releases. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    SPTarkov.* packages come from nuget.org. Versions pinned to 4.0.13 (matches D:\SPTarkov4.0).
      - PrivateAssets="all"      = don't propagate this dep to projects that reference us
      - ExcludeAssets="runtime"  = don't copy the package DLLs into our build output
                                   (SPT loads its own copies at runtime; copying would conflict)
  -->
  <ItemGroup>
    <PackageReference Include="SPTarkov.Common" Version="4.1.1">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="SPTarkov.DI" Version="4.1.1">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="SPTarkov.Server.Core" Version="4.1.1">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <!--
      Blazor web UI. Brings in MudBlazor and BaseMudBlazorLayout. Same exclusions as the
      others: the server already has these loaded, so shipping our own copies would clash.
    -->
    <PackageReference Include="SPTarkov.Server.Web" Version="4.1.1">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Markdig renders the documentation markdown at runtime. Unlike the SPT packages above this
    one is NOT excluded: the server does not provide it, so Markdig.dll has to ship next to
    ModSync.dll in the mod folder.
  -->
  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
  </ItemGroup>

  <!--
    Docs are embedded in the assembly rather than shipped as loose files, so they cannot be
    half-deployed or edited into a broken state on a live server. They are authored as plain
    markdown so the same sources can feed the GitHub wiki.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Docs\*.md" />
  </ItemGroup>

  <!--
    Shared utility code (MetroHash, ImoHash, Glob, ModFile, SyncPath) - same code the
    BepInEx client uses. This is the killer benefit of doing both sides in C#: client
    and server compute byte-identical hashes from a single source.
  -->
  <Import Project="..\ModSync.Utility\ModSync.Utility.projitems" Label="Shared" />

</Project>
