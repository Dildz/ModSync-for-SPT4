@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Routing
@using MudBlazor
@page "/modsync/{PageId}"
@namespace ModSync.Server.Web.Pages
@using ModSync.Server
@layout ModSync.Server.Web.Layouts.MainLayout

@*
    Phase A: documentation only, no editing. The point is that the config reference lives
    where people already are - inside the server they just installed - instead of on a wiki
    they have to know exists to find.

    /modsync itself is the landing page (Index.razor); this route deep-links to one doc page.
    The nav is grouped because DocsService now carves the long source documents into short
    pages - one flat list of eleven entries would just move the scrolling problem.
*@

<MudGrid>
    <MudItem xs="12" md="3">
        <MudPaper Class="pa-2" Elevation="1">
            <MudNavMenu>
                <MudNavLink Href="/modsync"
                            Match="NavLinkMatch.All"
                            Icon="@Icons.Material.Filled.ArrowBack">
                    Overview
                </MudNavLink>

                <MudDivider Class="my-2" />

                @* Loop variable is deliberately NOT called `page`: `@page.Title` gets parsed
                   as a @page directive and fails the build with RZ1011. *@
                @foreach (var group in DocsService.ByGroup)
                {
                    <MudNavGroup Title="@group.Key" Expanded="@group.Any(d => d.Id == Current?.Id)">
                        @foreach (var doc in group)
                        {
                            <MudNavLink Href="@($"/modsync/{doc.Id}")"
                                        Match="NavLinkMatch.All"
                                        Icon="@Icons.Material.Filled.Article">
                                @doc.Title
                            </MudNavLink>
                        }
                    </MudNavGroup>
                }
            </MudNavMenu>
        </MudPaper>

        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-4">
            Editing the config from here is not implemented yet. Changes still go in
            <code>config.jsonc</code>, and the server needs a restart to pick them up.
        </MudAlert>
    </MudItem>

    <MudItem xs="12" md="9">
        <MudPaper Class="pa-6" Elevation="1">
            @if (Current is null)
            {
                <MudText Typo="Typo.h6">Not found</MudText>
                <MudText Typo="Typo.body2">There is no documentation page called "@PageId".</MudText>
            }
            else
            {
                @* The HTML comes from our own markdown, compiled into the assembly, so there
                   is no user-supplied content to sanitise here. *@
                <div class="modsync-docs">@((MarkupString)Current.Html)</div>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

<style>
    /* MudBlazor styles its own components, not raw HTML from markdown, so give the rendered
       document readable defaults and stop wide tables and code blocks blowing out the page. */
    .modsync-docs table { border-collapse: collapse; margin: 1rem 0; display: block; overflow-x: auto; }
    .modsync-docs th, .modsync-docs td { border: 1px solid rgba(255,255,255,.15); padding: .4rem .6rem; }
    .modsync-docs pre { background: rgba(0,0,0,.35); padding: .8rem; border-radius: 4px; overflow-x: auto; }
    .modsync-docs code { background: rgba(0,0,0,.35); padding: .1rem .3rem; border-radius: 3px; }
    .modsync-docs pre code { background: none; padding: 0; }
    .modsync-docs blockquote { border-left: 3px solid rgba(255,255,255,.25); margin: 1rem 0; padding: .2rem 1rem; }
    .modsync-docs img { max-width: 100%; }
    .modsync-docs h1, .modsync-docs h2 { border-bottom: 1px solid rgba(255,255,255,.12); padding-bottom: .3rem; }

    /* Callouts. The docs use GitHub's `> [!NOTE]` syntax and Markdig renders it into
       .markdown-alert divs, icon included - but a class name is only a label, and nothing
       supplies the styling. GitHub ships CSS for these; MudBlazor styles its own components
       and has no opinion about markdown output. Without the rules below all 26 callouts read
       as ordinary body text, which loses the one thing a callout is for.

       Colours come from the MudBlazor palette so they track the server's theme, with a literal
       fallback for anywhere the variable is not defined. */
    .modsync-docs .markdown-alert {
        border-left: 3px solid var(--mud-palette-lines-default, rgba(255,255,255,.25));
        background: rgba(255,255,255,.05);
        padding: .6rem 1rem;
        margin: 1rem 0;
        border-radius: 0 4px 4px 0;
    }
    .modsync-docs .markdown-alert > :first-child { margin-top: 0; }
    .modsync-docs .markdown-alert > :last-child { margin-bottom: 0; }
    .modsync-docs .markdown-alert-title { font-weight: 600; display: flex; align-items: center; gap: .4rem; }
    .modsync-docs .markdown-alert-title svg { width: 1em; height: 1em; fill: currentColor; flex: none; }

    .modsync-docs .markdown-alert-note { border-left-color: var(--mud-palette-info, #5b9bd5); }
    .modsync-docs .markdown-alert-note .markdown-alert-title { color: var(--mud-palette-info, #8cc0ea); }
    .modsync-docs .markdown-alert-tip { border-left-color: var(--mud-palette-success, #5cc9a7); }
    .modsync-docs .markdown-alert-tip .markdown-alert-title { color: var(--mud-palette-success, #7fd9bd); }
    .modsync-docs .markdown-alert-warning { border-left-color: var(--mud-palette-warning, #e0a750); }
    .modsync-docs .markdown-alert-warning .markdown-alert-title { color: var(--mud-palette-warning, #edc07d); }
    .modsync-docs .markdown-alert-important { border-left-color: var(--mud-palette-secondary, #a98cf0); }
    .modsync-docs .markdown-alert-important .markdown-alert-title { color: var(--mud-palette-secondary, #c3aef5); }
    /* CAUTION is the one GitHub type the docs do not use yet; styled anyway so adding one to the
       wiki later cannot silently produce an unstyled block. */
    .modsync-docs .markdown-alert-caution { border-left-color: var(--mud-palette-error, #e57373); }
    .modsync-docs .markdown-alert-caution .markdown-alert-title { color: var(--mud-palette-error, #ef9a9a); }
</style>

@code {
    [Parameter]
    public string? PageId { get; set; }

    [Inject]
    public DocsService DocsService { get; set; } = default!;

    // /modsync is the landing page now, so a missing PageId can only mean a malformed link.
    private DocPage? Current => string.IsNullOrEmpty(PageId) ? null : DocsService.Get(PageId);
}
