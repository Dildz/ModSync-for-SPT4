@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@page "/modsync/config"
@namespace ModSync.Server.Web.Pages
@using ModSync.Server
@using ModSync.Server.Web.Components
@layout ModSync.Server.Web.Layouts.MainLayout
@inject WebAuthService Auth
@inject WebAuthSession Session

@*
    Saving and the login that guards it shipped together, on purpose. This page writes the file that
    decides which DLLs land in every player's BepInEx folder, and it is served on the same port Fika
    clients sync against - so an unauthenticated version of it, once it could write, would be a
    remote shell rather than a config page.

    THE SHAPE OF THIS PAGE IS DELIBERATE, and it is not "a form over config.jsonc".

    There are two ways to run ModSync and they are not alternatives:
      lazy    - players get everything in the three BepInEx folders, minus the exclusions
      curated - some of those mods are made a player's choice instead

    Curated is lazy WITH CARVE-OUTS. The catch-alls stay on; a curated mod is an exception punched
    out of one, which works only because ConfigUtil sorts syncPaths by descending path length so the
    longer entry out-ranks the folder it sits inside. That is why section 2 never switches anything
    off, and why removing a mod from it reads as "back to everyone".

    Headless is a third, separate question - it has no F12 menu, so it cannot choose, and it gets its
    own allowlist. Hence three sections, always present, with no mode switch anywhere.
*@

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="/modsync" Size="Size.Small" />
    <MudText Typo="Typo.h5">ModSync</MudText>
</MudStack>

<MudText Typo="Typo.body2" Class="mb-4" Style="opacity:.7;">
    What your players download when they connect. This page is already set up - you can leave it
    exactly as it is. Reading <code>@ConfigEditorService.ConfigPath</code>.
</MudText>

@if (!Session.IsAuthenticated)
{
    <MudPaper Outlined="true" Class="pa-6 mx-auto" Style="max-width:420px;">
        <MudText Typo="Typo.h6" Class="mb-1">Sign in</MudText>
        <MudText Typo="Typo.body2" Class="mb-4" Style="opacity:.7;">
            The configuration page is protected because saving it decides what gets installed on
            every player's machine.
        </MudText>

        @if (!Auth.IsReady)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">
                No usable credentials were found. Check the server console - if
                <code>@ModSync.Utility.ProtectedFiles.WebAuthFileName</code> is unreadable, delete it
                and restart the server to be issued a new password.
            </MudAlert>
        }
        else
        {
            <MudForm>
                <MudTextField @bind-Value="_user" Label="Username" Margin="Margin.Dense"
                              Variant="Variant.Outlined" Class="mb-3" />
                <MudTextField @bind-Value="_password" Label="Password" Margin="Margin.Dense"
                              Variant="Variant.Outlined" InputType="InputType.Password"
                              OnKeyDown="@(async e => { if (e.Key == "Enter") await SignIn(); })" />

                @if (_loginError is not null)
                {
                    <MudText Typo="Typo.body2" Color="Color.Error" Class="mt-2">@_loginError</MudText>
                }

                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4"
                           FullWidth="true" OnClick="SignIn">Sign in</MudButton>
            </MudForm>

            @* Recovery without a reset flow, an email server, or a back door: the credential file is
               the only authority, so deleting it is the reset. Said here because an admin who has
               lost the password has no other way to find this out. *@
            <MudDivider Class="my-4" />
            <MudText Typo="Typo.body2" Style="opacity:.7;">
                <b>Forgotten the password?</b> Delete
                <code>@ModSync.Utility.ProtectedFiles.WebAuthFileName</code> from your game folder
                (next to <code>ModSync.Updater.exe</code>) and restart the server. A new password is
                generated and printed to the server console.
            </MudText>
        }
    </MudPaper>
}
else if (_draft is null)
{
    @if (_error is null)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else
    {
        <MudAlert Severity="Severity.Error">Could not read the config: @_error</MudAlert>
    }
}
else
{
    @* The whole of the "what goes where" guidance, collapsed. An admin who knows the answer never
       opens it; one who does not gets it without leaving the page for the wiki. *@
    <MudExpansionPanels Class="mb-6" Elevation="0">
        <MudExpansionPanel Text="Not sure where something goes?">
            <MudText Typo="Typo.subtitle2">Should every player get it?</MudText>
            <MudText Typo="Typo.body2" Class="mb-2" Style="opacity:.75;">
                Do nothing. Everything in the three folders below already goes to everyone.
            </MudText>

            <MudText Typo="Typo.subtitle2">Should players decide for themselves?</MudText>
            <MudText Typo="Typo.body2" Class="mb-2" Style="opacity:.75;">
                Add it under <b>Let players choose</b>. It becomes a checkbox in their F12 menu.
            </MudText>

            <MudText Typo="Typo.subtitle2">Should nobody ever get it?</MudText>
            <MudText Typo="Typo.body2" Class="mb-2" Style="opacity:.75;">
                Add it to <b>Never send these</b>. Server-only files, and anything with your details in it.
            </MudText>

            <MudText Typo="Typo.subtitle2">Should a Fika headless get it?</MudText>
            <MudText Typo="Typo.body2" Style="opacity:.75;">
                That is a separate list at the bottom, because a headless has no F12 menu to choose with.
            </MudText>
        </MudExpansionPanel>
    </MudExpansionPanels>

    @if (_warnings.Count > 0)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-6">
            @foreach (var warning in _warnings)
            {
                <MudText Typo="Typo.body2">
                    @if (!string.IsNullOrEmpty(warning.Path))
                    {
                        <code>@warning.Path</code>
                        <text> - </text>
                    }
                    @warning.Message
                </MudText>
            }
        </MudAlert>
    }

    @* ---------------- 1. everyone ---------------- *@
    <MudStack Row="true" AlignItems="AlignItems.Baseline" Spacing="2">
        <MudText Typo="Typo.h6">Everyone gets these</MudText>
        <MudText Typo="Typo.caption" Style="opacity:.6;">@SharedCatchAlls of 3 folders</MudText>
    </MudStack>
    <MudText Typo="Typo.body2" Class="mb-3" Style="opacity:.7;">
        Your whole client modset goes to every player who connects. Leave all three on unless you keep
        something in one of them that players must never receive.
    </MudText>

    <MudPaper Outlined="true" Class="mb-6">
        @foreach (var path in ConfigEditorService.CatchAlls)
        {
            var row = _draft.SyncPaths.Find(r => ConfigEditorService.IsCatchAll(r.Path)
                                                 && r.Path.Replace('\\', '/') == path);
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="pa-3" Spacing="2">
                <div style="flex:1;min-width:0;">
                    <MudText Typo="Typo.body1"><code>@path</code></MudText>
                    <MudText Typo="Typo.caption" Style="opacity:.6;">@EntryCount(path)</MudText>
                </div>
                <MudSwitch T="bool" Color="Color.Primary"
                           Value="@(row is not null)"
                           ValueChanged="@(on => ToggleCatchAll(path, on))" />
            </MudStack>
            <MudDivider />
        }

        <MudExpansionPanels Elevation="0">
            <MudExpansionPanel Text="@($"Never send these ({_draft.Exclusions.Count})")">
                <MudText Typo="Typo.body2" Class="mb-3" Style="opacity:.75;">
                    Files inside those folders that must not go out. ModSync ships the first few - they
                    guard SPT's own client files. Add your own below.
                </MudText>
                <StringList Label="Exclusions" Placeholder="**/.git"
                            Items="_draft.Exclusions" OnChanged="Revalidate" />
            </MudExpansionPanel>
        </MudExpansionPanels>
    </MudPaper>

    @* ---------------- 2. curated ---------------- *@
    <MudStack Row="true" AlignItems="AlignItems.Baseline" Spacing="2">
        <MudText Typo="Typo.h6">Let players choose</MudText>
        <MudText Typo="Typo.caption" Style="opacity:.6;">
            @(_curated.Count == 0 ? "none yet" : $"{_curated.Count} mod{(_curated.Count == 1 ? "" : "s")}")
        </MudText>
    </MudStack>
    <MudText Typo="Typo.body2" Class="mb-3" Style="opacity:.7;">
        Everything above goes to everyone by default. Put a mod here instead and it becomes a checkbox
        in the player's F12 menu, so they install it or they do not.
    </MudText>

    <MudPaper Outlined="true" Class="mb-6">
        @if (_curated.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="pa-4" Align="Align.Center" Style="opacity:.6;">
                Nothing is optional yet, so every player gets every mod.
            </MudText>
        }

        @foreach (var mod in _curated)
        {
            var lead = mod.Rows[0];
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="pa-3" Spacing="2">
                <div style="flex:1;min-width:0;">
                    <MudText Typo="Typo.body1">@mod.Label</MudText>
                    <MudText Typo="Typo.caption" Style="opacity:.6;"><code>@lead.Path</code></MudText>
                </div>

                @* One control, and it is the only thing about a curated mod a player can tell apart:
                   whether their checkbox arrives ticked. `optional:true` and `enabled:false` are the
                   two minimal spellings of that, which SetStart writes for us. *@
                <MudSelect T="bool" Value="@lead.Enabled" Dense="true" Margin="Margin.Dense"
                           Style="max-width:190px;"
                           ValueChanged="@(v => SetStart(mod, v))">
                    <MudSelectItem T="bool" Value="false">starts unticked</MudSelectItem>
                    <MudSelectItem T="bool" Value="true">starts ticked</MudSelectItem>
                </MudSelect>

                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                               title="Back to everyone" aria-label="@($"Remove {mod.Label}, back to everyone")"
                               OnClick="@(() => RemoveMod(mod))" />
            </MudStack>

            @* Extra rows the mod owns - normally its BepInEx config file. Shown as its own line so a
               wrong guess is visible and one click from gone. *@
            @foreach (var extra in mod.Rows.Skip(1))
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="pa-3 pl-8" Spacing="2"
                          Style="background:var(--mud-palette-background-grey);">
                    <div style="flex:1;min-width:0;">
                        <MudText Typo="Typo.body2" Style="opacity:.8;">and its config file</MudText>
                        <MudText Typo="Typo.caption" Style="opacity:.6;"><code>@extra.Path</code></MudText>
                    </div>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                   title="Do not include this config file"
                                   OnClick="@(() => RemoveRow(mod, extra))" />
                </MudStack>
            }
            <MudDivider />
        }

        <MudStack Row="true" AlignItems="AlignItems.Center" Class="pa-3" Spacing="2" Wrap="Wrap.Wrap">
            <MudSelect T="string" @bind-Value="_pick" Dense="true" Margin="Margin.Dense"
                       Placeholder="Choose a mod on your server..." Style="flex:1;min-width:220px;"
                       Clearable="true">
                @foreach (var candidate in AvailableMods)
                {
                    <MudSelectItem T="string" Value="@candidate.Path">
                        @candidate.Name (@candidate.Area)
                    </MudSelectItem>
                }
            </MudSelect>
            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                       Disabled="@string.IsNullOrEmpty(_pick)" OnClick="AddPickedMod">Add</MudButton>
            <MudButton Variant="Variant.Text" Size="Size.Small"
                       OnClick="@(() => _showPathEntry = !_showPathEntry)">
                @(_showPathEntry ? "Never mind" : "Add any path instead")
            </MudButton>
        </MudStack>

        @if (_showPathEntry)
        {
            <div class="pa-3 pt-0">
                <MudTextField @bind-Value="_manualPath" Margin="Margin.Dense" Immediate="true"
                              Placeholder="../BepInEx/plugins/SomeMod" Label="Path" />
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="mt-2"
                           Disabled="@string.IsNullOrWhiteSpace(_manualPath)"
                           OnClick="AddManualPath">Add path</MudButton>

                @* Not hypothetical: the wiki documents a server-mods recipe, and following it here
                   would ship config.jsonc - and anything kept beside it - to every connecting client. *@
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">
                    <b>Careful with server folders.</b> Adding the server's own <code>user/mods</code>
                    sends your server mods to every player, and that includes this config file and
                    anything else you keep beside it. Almost nobody wants this.
                </MudAlert>
            </div>
        }
    </MudPaper>

    @* ---------------- 3. headless ---------------- *@
    <MudStack Row="true" AlignItems="AlignItems.Baseline" Spacing="2">
        <MudText Typo="Typo.h6">Headless clients</MudText>
        <MudText Typo="Typo.caption" Style="opacity:.6;">
            @_draft.HeadlessIncludes.Count of @_pluginCount plugins
        </MudText>
    </MudStack>
    <MudText Typo="Typo.body2" Class="mb-3" Style="opacity:.7;">
        A Fika headless has no F12 menu, so it cannot choose. It gets its own list instead, because
        plenty of client mods have no business on one - anything that draws a UI, or is tied to a
        graphics card.
    </MudText>

    <MudPaper Outlined="true" Class="mb-6 pa-3">
        @if (_draft.HeadlessIncludes.Count == 0)
        {
            @* Fail-closed is deliberate in SyncUtil, so this is a warning about intent, not a bug. *@
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                <b>This list is empty, so a headless gets no plugins at all.</b> That is deliberate on
                ModSync's part - it fails closed rather than guessing - but it almost certainly is not
                what you want.
            </MudAlert>
        }

        @if (!_editHeadless)
        {
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-3">
                @foreach (var include in _draft.HeadlessIncludes.Take(10))
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@Leaf(include)</MudChip>
                }
                @if (_draft.HeadlessIncludes.Count > 10)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text">
                        +@(_draft.HeadlessIncludes.Count - 10) more
                    </MudChip>
                }
            </MudStack>
            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                       OnClick="@(() => _editHeadless = true)">Edit this list</MudButton>
        }
        else
        {
            <MudTextField @bind-Value="_headlessFilter" Margin="Margin.Dense" Immediate="true"
                          Placeholder="Filter plugins" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-2" />

            <div style="max-height:320px;overflow-y:auto;">
                @foreach (var plugin in FilteredPlugins)
                {
                    <MudCheckBox T="bool" Dense="true" Size="Size.Small"
                                 Value="@_draft.HeadlessIncludes.Contains(plugin.Path)"
                                 ValueChanged="@(on => ToggleHeadless(plugin.Path, on))">
                        @plugin.Name
                    </MudCheckBox>
                }
                @if (FilteredPlugins.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="pa-2" Style="opacity:.6;">Nothing matches.</MudText>
                }
            </div>

            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-2" Spacing="2">
                <MudButton Variant="Variant.Outlined" Size="Size.Small"
                           OnClick="@(() => { _editHeadless = false; _headlessFilter = string.Empty; })">Done</MudButton>
                <MudSpacer />
                <MudText Typo="Typo.caption" Style="opacity:.6;">
                    @_draft.HeadlessIncludes.Count selected
                </MudText>
            </MudStack>
        }
    </MudPaper>

    @* Managed allowlists stay out of the three sections on purpose: they are an EscapeFromTarkov_Data
       concern rather than a mod, almost always empty, and putting them above would make the common
       case look more complicated than it is. *@
    <MudExpansionPanels Elevation="0" Class="mb-6">
        <MudExpansionPanel Text="Base game files (advanced)">
            <MudText Typo="Typo.body2" Class="mb-3" Style="opacity:.75;">
                Allowlists over <code>EscapeFromTarkov_Data/Managed</code>. Nothing there is sent
                unless it is named here. Most servers leave both empty.
            </MudText>
            <StringList Label="Managed includes" Placeholder="Unity.VectorGraphics.dll"
                        Items="_draft.ManagedIncludes" OnChanged="Revalidate" />
            <div class="mt-4"></div>
            <StringList Label="Headless managed includes" Placeholder=""
                        Items="_draft.HeadlessManagedIncludes" OnChanged="Revalidate" />
        </MudExpansionPanel>
    </MudExpansionPanels>

    @* ---------------- save ---------------- *@
    @if (_saveError is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">Could not save: @_saveError</MudAlert>
    }
    else if (_saved)
    {
        <MudAlert Severity="Severity.Success" Class="mb-4">
            Saved. <b>Restart the server to apply it</b> - players pick the changes up on their next connect.
        </MudAlert>
    }

    <MudPaper Outlined="true" Class="pa-3 mb-6">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
            <div style="flex:1;min-width:0;">
                <MudText Typo="Typo.body2">
                    @SharedCatchAlls folders shared, @_curated.Count optional,
                    @_draft.HeadlessIncludes.Count to headless
                </MudText>
                <MudText Typo="Typo.caption" Style="opacity:.6;">
                    Your current file is copied to <code>config.jsonc.bak</code> the first time you save.
                </MudText>
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       Disabled="@_saving" OnClick="Save">
                @(_saving ? "Saving..." : "Save changes")
            </MudButton>
        </MudStack>
    </MudPaper>

    @* ---------------- account ---------------- *@
    <MudExpansionPanels Elevation="0" Class="mb-6">
        <MudExpansionPanel Text="Change password">
            <MudText Typo="Typo.body2" Class="mb-3" Style="opacity:.75;">
                The password issued on first boot is fine, but it is long and awkward to type. Signed
                in as <b>@Auth.Username</b>.
            </MudText>

            <MudTextField @bind-Value="_currentPassword" Label="Current password" Margin="Margin.Dense"
                          Variant="Variant.Outlined" InputType="InputType.Password" Class="mb-3" />
            <MudTextField @bind-Value="_newPassword" Label="New password" Margin="Margin.Dense"
                          Variant="Variant.Outlined" InputType="InputType.Password" Immediate="true"
                          HelperText="At least 8 characters, with an uppercase letter, a number and a special character." />

            @if (_passwordMessage is not null)
            {
                <MudText Typo="Typo.body2" Color="@(_passwordChanged ? Color.Success : Color.Error)" Class="mt-2">
                    @_passwordMessage
                </MudText>
            }

            <MudButton Variant="Variant.Outlined" Class="mt-4" OnClick="ChangePassword">Change password</MudButton>
        </MudExpansionPanel>
    </MudExpansionPanels>
}

@code {
    private ConfigDraft? _draft;
    private string? _error;
    private IReadOnlyList<ConfigWarning> _warnings = [];
    private List<CuratedMod> _curated = [];

    // Read once per visit: the disk does not change while the page is open, and re-scanning on every
    // keystroke in the filter box would stat the plugins folder for nothing.
    private List<ClientMod> _installed = [];
    private List<string> _configFiles = [];
    private int _pluginCount;

    private string? _pick;
    private string _manualPath = string.Empty;
    private bool _showPathEntry;
    private bool _editHeadless;
    private string _headlessFilter = string.Empty;

    private string _user = WebAuthService.DefaultUsername;
    private string _password = string.Empty;
    private string? _loginError;

    private bool _saving;
    private bool _saved;
    private string? _saveError;

    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string? _passwordMessage;
    private bool _passwordChanged;

    private int SharedCatchAlls =>
        _draft is null ? 0 : ConfigEditorService.CatchAlls.Count(p => _draft.SyncPaths.Exists(r => r.Path.Replace('\\', '/') == p));

    /// <summary>Installed mods that are not already carved out, so the picker never offers a duplicate.</summary>
    private IEnumerable<ClientMod> AvailableMods =>
        _draft is null
            ? []
            : _installed.Where(m => !_draft.SyncPaths.Exists(r => r.Path.Replace('\\', '/') == m.Path));

    private List<ClientMod> FilteredPlugins =>
        [.. _installed.Where(m => m.Area == "plugins"
                                  && (string.IsNullOrWhiteSpace(_headlessFilter)
                                      || m.Name.Contains(_headlessFilter, StringComparison.OrdinalIgnoreCase)))];

    private static string Leaf(string path) => path.Replace('\\', '/').Split('/')[^1];

    private string EntryCount(string path)
    {
        var n = ClientModScanner.CountEntries(Directory.GetCurrentDirectory(), path);
        return n == 0 ? "empty, or not present on this server" : $"{n} entr{(n == 1 ? "y" : "ies")}";
    }

    private async Task SignIn()
    {
        // No lockout and no attempt counter: this runs over a SignalR circuit rather than a public
        // endpoint, the password is 16 random characters, and PBKDF2 at 210k iterations already
        // makes each guess cost real time. A counter here would mostly be a way for a stranger to
        // lock the admin out of their own server.
        if (!Auth.Verify(_user, _password))
        {
            _loginError = "That username and password did not match.";
            _password = string.Empty;
            return;
        }

        _loginError = null;
        _password = string.Empty;
        Session.Grant();

        // The config was never read while logged out - loading it is part of signing in.
        await LoadDraft();
    }

    private void ChangePassword()
    {
        _passwordChanged = false;

        // Proving the current password matters even though the circuit is already authenticated:
        // it is what stops someone who walks up to an unlocked browser from locking the admin out.
        if (!Auth.Verify(Auth.Username, _currentPassword))
        {
            _passwordMessage = "That is not the current password.";
            return;
        }

        var problem = WebAuthService.DescribePasswordProblem(_newPassword);
        if (problem is not null)
        {
            _passwordMessage = problem;
            return;
        }

        Auth.SetPassword(_newPassword);
        _currentPassword = string.Empty;
        _newPassword = string.Empty;
        _passwordChanged = true;
        _passwordMessage = "Password changed.";
    }

    private async Task Save()
    {
        // The gate that actually matters. Everything above is a rendering decision; this is the
        // line an unauthenticated caller would have to get past to write the file.
        if (!Session.IsAuthenticated || _draft is null) return;

        _saving = true;
        _saveError = null;
        _saved = false;

        try
        {
            await ConfigEditorService.SaveAsync(_draft);
            _saved = true;
        }
        catch (Exception ex)
        {
            _saveError = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Auth.EnsureCredentials();
        if (Session.IsAuthenticated) await LoadDraft();
    }

    private async Task LoadDraft()
    {
        try
        {
            _draft = await ConfigEditorService.LoadDraftAsync();

            var root = Directory.GetCurrentDirectory();
            _installed = ClientModScanner.Scan(root);
            _configFiles = ClientModScanner.ConfigFiles(root);
            _pluginCount = _installed.Count(m => m.Area == "plugins");

            Refresh();
        }
        catch (Exception ex)
        {
            // A malformed config is the admin's problem to fix, but it must not present as a blank
            // page - say what went wrong and leave config.jsonc alone.
            _error = ex.Message;
        }
    }

    private void Refresh()
    {
        if (_draft is null) return;

        // Any edit invalidates "Saved" - leaving that banner up over changed content would tell an
        // admin their current screen is on disk when it is not.
        _saved = false;

        _curated = ConfigEditorService.Curated(_draft);
        _warnings = ConfigEditorService.Validate(_draft);
    }

    private void Revalidate() => Refresh();

    private void ToggleCatchAll(string path, bool on)
    {
        if (_draft is null) return;

        if (on)
        {
            // Prepended, not appended: the catch-alls read as the base layer of the file, and the
            // carve-outs below them. Order has no effect on behaviour - ConfigUtil sorts by path
            // length - so this is purely so the file still reads the way an admin wrote it.
            _draft.SyncPaths.Insert(0, new SyncPathRow { Path = path, Name = path });
        }
        else
        {
            _draft.SyncPaths.RemoveAll(r => r.Path.Replace('\\', '/') == path);
        }

        Refresh();
    }

    /// <summary>
    /// Write the minimal spelling of "starts ticked" across every row the mod owns, so a mod and its
    /// config file can never disagree about whether the player has it.
    /// </summary>
    private void SetStart(CuratedMod mod, bool ticked)
    {
        foreach (var row in mod.Rows)
        {
            row.Optional = ticked;
            row.Enabled = ticked;
        }
        Refresh();
    }

    private void RemoveMod(CuratedMod mod)
    {
        if (_draft is null) return;
        foreach (var row in mod.Rows) _draft.SyncPaths.Remove(row);
        Refresh();
    }

    private void RemoveRow(CuratedMod mod, SyncPathRow row)
    {
        if (_draft is null) return;
        _draft.SyncPaths.Remove(row);
        mod.Rows.Remove(row);
        Refresh();
    }

    private void AddPickedMod()
    {
        if (_draft is null || string.IsNullOrEmpty(_pick)) return;

        var mod = _installed.Find(m => m.Path == _pick);
        if (mod is null) return;

        AddCurated(mod.Path, mod.Name);

        // Its config file is a guess and only right about two thirds of the time, so it is added as
        // its own visible row the admin can delete - never folded into the mod silently.
        var suggested = ClientModScanner.SuggestConfigFile(mod.Name, _configFiles);
        if (suggested is not null && !_draft.SyncPaths.Exists(r => r.Path.Replace('\\', '/') == suggested))
            AddCurated(suggested, $"{mod.Name} - config");

        _pick = null;
        Refresh();
    }

    private void AddManualPath()
    {
        if (_draft is null || string.IsNullOrWhiteSpace(_manualPath)) return;

        var path = _manualPath.Trim().Replace('\\', '/');
        if (!_draft.SyncPaths.Exists(r => r.Path.Replace('\\', '/') == path))
            AddCurated(path, ClientModScanner.TrimDll(Leaf(path)));

        _manualPath = string.Empty;
        Refresh();
    }

    /// <summary>
    /// A new carve-out starts unticked - the opt-in shape, and the safe default: a player who does
    /// nothing ends up with less than before rather than more.
    /// </summary>
    private void AddCurated(string path, string name) =>
        _draft?.SyncPaths.Add(new SyncPathRow { Path = path, Name = name, Enabled = false });

    private void ToggleHeadless(string path, bool on)
    {
        if (_draft is null) return;

        if (on)
        {
            if (!_draft.HeadlessIncludes.Contains(path)) _draft.HeadlessIncludes.Add(path);
        }
        else
        {
            _draft.HeadlessIncludes.Remove(path);
        }

        Refresh();
    }
}
