<Project Sdk="Microsoft.NET.Sdk">

  <!--
    BepInEx plugin targeting .NET Framework 4.7.2 - this is what EFT/Unity's Mono runtime expects.
    Do NOT bump to net10 here; the *server* mod (ModSync.Server) uses .NET 10, but BepInEx client
    plugins are constrained by the game's runtime.
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>Corter-ModSync</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!--
    BepInEx + Harmony come from the BepInEx NuGet feed (configured in ../nuget.config).
    This replaces corter's old HintPath refs to ..\..\..\BepInEx\core\*.dll which assumed the
    project lived inside the SPT install at user\mods\Corter-ModSync\src\.
  -->
  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.*" />
  </ItemGroup>

  <!--
    SPT/EFT/Unity references - all resolved from ..\References\ which is bundled in the repo.
    See ..\References\README.md for the full source/refresh story.

    Private="false" tells MSBuild "don't copy these to bin/ on build" - they're compile-time only.
    At runtime, EFT/SPT load their own copies from the user's game install.
  -->
  <ItemGroup>
    <!-- SPT modules -->
    <Reference Include="spt-common" HintPath="..\References\spt-common.dll" Private="false" />
    <Reference Include="spt-core" HintPath="..\References\spt-core.dll" Private="false" />
    <Reference Include="spt-custom" HintPath="..\References\spt-custom.dll" Private="false" />
    <Reference Include="spt-reflection" HintPath="..\References\spt-reflection.dll" Private="false" />

    <!-- EFT-side game DLLs (Assembly-CSharp is hollowed - see References/README.md) -->
    <Reference Include="Assembly-CSharp" HintPath="..\References\Assembly-CSharp.dll" Private="false" />
    <Reference Include="bsg.console.core" HintPath="..\References\bsg.console.core.dll" Private="false" />
    <Reference Include="Comfort" HintPath="..\References\Comfort.dll" Private="false" />
    <Reference Include="Comfort.Unity" HintPath="..\References\Comfort.Unity.dll" Private="false" />
    <Reference Include="Newtonsoft.Json" HintPath="..\References\Newtonsoft.Json.dll" Private="false" />
    <Reference Include="Sirenix.Serialization" HintPath="..\References\Sirenix.Serialization.dll" Private="false" />

    <!-- Unity engine modules -->
    <Reference Include="Unity.TextMeshPro" HintPath="..\References\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="..\References\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.AssetBundleModule" HintPath="..\References\UnityEngine.AssetBundleModule.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="..\References\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="..\References\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="..\References\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="..\References\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="..\References\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="..\References\UnityEngine.UI.dll" Private="false" />

    <!-- BCL ref - part of the .NET Framework 4.7.2 reference assemblies, no DLL needed -->
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <!-- ModSync.GUI/ contains hand-rolled IMGUI controls; pulled in as additional sources. -->
  <ItemGroup>
    <Compile Include="ModSync.GUI\*.cs" />
    <!-- CRC-32 for verifying bundles fetched on a headless (HeadlessBundles). Linked rather than
         taken via the shared projitems so it does not land in ModSync.Server.dll, which has no use
         for it. NOTE: reference it as ModSyncCrc32 - SPT.Custom.Utils also declares a Crc32 that
         exists in the 4.1.1 reference DLLs but NOT at runtime on 4.1.3. -->
    <Compile Include="..\ModSync.Utility\Crc32.cs" />
  </ItemGroup>

  <!-- Kept from corter - these support net472 BCL features. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="System.Data.DataSetExtensions" Version="4.5.0" />
  </ItemGroup>

  <!-- Shared utility code (MetroHash, Glob, ImoHash, ModFile, SyncPath) lives here. -->
  <Import Project="..\ModSync.Utility\ModSync.Utility.projitems" Label="Shared" />
</Project>
